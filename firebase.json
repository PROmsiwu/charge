{
  "database": { "rules": "database.rules.json" },
  "hosting": {
    "public": ".",
    "ignore": ["firebase.json", ".firebaserc", "database.rules.json", "README.md"],
    "cleanUrls": true,
    "headers": [
      { "source": "**/*.js", "headers": [{ "key": "Cache-Control", "value": "public,max-age=3600" }] },
      { "source": "**/*.css", "headers": [{ "key": "Cache-Control", "value": "public,max-age=3600" }] }
    ]
  }
}
